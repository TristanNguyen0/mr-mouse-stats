# Lambda container image for both FastAPI apps.
#
# One image, two functions: the handler differs per function
# (mr_mouse_stats.api.lambda_handlers.public_handler / .admin_handler), so
# there is nothing app-specific baked in here.
#
#   docker build -f Dockerfile.lambda -t mr-mouse-stats-api .

FROM public.ecr.aws/lambda/python:3.12 AS build

COPY --from=ghcr.io/astral-sh/uv:0.9.29 /uv /usr/local/bin/uv

WORKDIR /build
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy

COPY pyproject.toml uv.lock README.md ./
COPY mr_mouse_stats ./mr_mouse_stats

# Install into the Lambda task root rather than a venv: the runtime adds
# ${LAMBDA_TASK_ROOT} to sys.path, and a venv would need activation.
RUN uv export --locked --no-dev --no-emit-project > requirements.txt \
    && uv pip install --system --target "${LAMBDA_TASK_ROOT}" -r requirements.txt \
    && uv pip install --system --target "${LAMBDA_TASK_ROOT}" --no-deps .


FROM public.ecr.aws/lambda/python:3.12

COPY --from=build ${LAMBDA_TASK_ROOT} ${LAMBDA_TASK_ROOT}

ENV TZ=UTC

# Overridden per function by the Terraform image_config.
CMD ["mr_mouse_stats.api.lambda_handlers.public_handler"]
